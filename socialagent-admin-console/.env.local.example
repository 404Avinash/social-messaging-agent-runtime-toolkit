# Copy to .env.local and fill in values from: terraform -chdir=infra-terraform output
# VITE_API_URL is the api_url output with "api" appended (as `make ui-deploy` builds it).
VITE_API_URL=https://<your-api-id>.execute-api.us-east-1.amazonaws.com/api
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AWS_REGION=us-east-1
